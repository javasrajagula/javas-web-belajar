# Academy OS Omega - Environment Variables

# Required: PostgreSQL database used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Required: Auth.js / NextAuth secret.
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Required in production for live AI. At least one provider key is needed.
# Used by /api/ai/tutor, /api/ai/generate-soal, and /api/pdf/process.
GEMINI_API_KEY="your_gemini_api_key_here"
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional: Upstash Redis for rate limiting. If unset, the app should remain usable
# with local/dev fallbacks depending on the ratelimit helper.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional OAuth providers.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public app config.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Academy OS Omega"
