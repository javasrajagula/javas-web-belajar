datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  student
  teacher
  parent
  admin
  school
}

enum SchoolType {
  sma
  smk
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Custom Profile fields
  role               UserRole    @default(student)
  schoolType         SchoolType  @default(sma)
  grade              Int         @default(10)
  selectedPathway    String      @default("Umum")
  xp                 Int         @default(0)
  level              Int         @default(1)
  streak             Int         @default(0)
  dailyGoalMinutes   Int         @default(45)
  dailyGoalXp        Int         @default(200)
  goals              String[]    @default([])
  studyTimeToday     Int         @default(0)
  avatar             String?
  skills             Json?       // Stores { focus: number, logic: number, creativity: number, discipline: number }
  weeklyProgress     Json?       // Stores array of { day: string, minutes: number, xp: number }
  weakTopics         Json?       // Stores array of { topic: string, mastery: number }
  dailyQuests        Json?       // Stores array of DailyQuest
  lastActive         DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  progress           Progress[]
  internships        Internship[]
  portfolioProjects  PortfolioProject[]

  // Guild relations
  guildId            String?
  guild              Guild?      @relation(fields: [guildId], references: [id])
  userJurusan        UserJurusan[]
  hasilUjian         HasilUjian[]
  materiProgress     MateriProgress[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CurriculumVersion {
  id            String   @id @default(uuid())
  version       String   @unique
  effectiveDate DateTime
  status        String   @default("active")
  createdAt     DateTime @default(now())
}

model Subject {
  id             String     @id
  title          String
  phase          String     // "E" or "F"
  schoolType     SchoolType
  grade          Int
  cpStatement    String
  isDigitalSkill Boolean    @default(false)
  modules        Module[]
}

model Module {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  lessons   Lesson[]
}

model Lesson {
  id            String      @id @default(uuid())
  moduleId      String
  module        Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  explanation   String      @db.Text
  visualExample String      @db.Text
  summary       String      @db.Text
  hotsQuestions Json        // Store array of hots questions
  practiceBank  Json        // Store array of practice questions
  sortOrder     Int         @default(0)
  podcastScript Json?       // Store array of podcast lines { role, text }
  quizzes       Quiz[]
  flashcards    Flashcard[]
  progress      Progress[]
}

model Quiz {
  id                 String   @id @default(uuid())
  lessonId           String
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question           String   @db.Text
  options            String[]
  correctOptionIndex Int
  explanation        String   @db.Text
}

model Flashcard {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  front    String @db.Text
  back     String @db.Text
}

model Progress {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed       Boolean   @default(false)
  scorePercentage Int?
  completedAt     DateTime?

  @@unique([userId, lessonId])
}

model Internship {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  mentorName  String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ongoing")
}

model PortfolioProject {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String   @db.Text
  projectUrl    String?
  repositoryUrl String?
  skillsUsed    String[] @default([])
  gradeScore    Int?
  createdAt     DateTime @default(now())
}

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  xp          Int      @default(0)
  members     User[]
  createdAt   DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  embedding  Json?    // Array of floats
}

model Jurusan {
  id              String          @id @default(cuid())
  kode            String          @unique
  nama            String
  bidang          String
  deskripsi       String
  icon            String
  warna           String
  popular         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  mataPelajaran   MataPelajaran[]
  userJurusan     UserJurusan[]
}

model MataPelajaran {
  id          String    @id @default(cuid())
  jurusanId   String
  jurusan     Jurusan   @relation(fields: [jurusanId], references: [id], onDelete: Cascade)
  kode        String
  nama        String
  kelas       Int
  semester    Int
  deskripsi   String
  createdAt   DateTime  @default(now())
  bab         Bab[]
  bankSoal    BankSoal[]
}

model Bab {
  id              String        @id @default(cuid())
  mataPelajaranId String
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  nomor           Int
  judul           String
  deskripsi       String
  estimasiMenit   Int
  createdAt       DateTime      @default(now())
  materi          Materi[]
}

model Materi {
  id             String           @id @default(cuid())
  babId          String
  bab            Bab              @relation(fields: [babId], references: [id], onDelete: Cascade)
  judul          String
  tipe           String
  konten         String           @db.Text
  urutan         Int
  createdAt      DateTime         @default(now())
  materiProgress MateriProgress[]
}

model BankSoal {
  id              String        @id @default(cuid())
  mataPelajaranId String
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  pertanyaan      String        @db.Text
  tipe            String
  pilihan         Json?
  jawabanBenar    String        @db.Text
  pembahasan      String        @db.Text
  tingkat         String
  kelas           Int
  tahunAjaran     String?
  sumber          String?
  tags            String[]
  createdAt       DateTime      @default(now())
}

model UserJurusan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jurusanId String
  jurusan   Jurusan  @relation(fields: [jurusanId], references: [id])
  kelas     Int
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@unique([userId, jurusanId])
}

model HasilUjian {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mataPelajaranId String
  judul           String
  tipe            String
  totalSoal       Int
  benar           Int
  salah           Int
  nilaiAkhir      Float
  durasiDetik     Int
  jawabanDetail   Json
  createdAt       DateTime @default(now())
}

model MateriProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materiId    String
  materi      Materi   @relation(fields: [materiId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())
  @@unique([userId, materiId])
}
